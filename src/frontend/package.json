{
  "name": "astro_x_frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "coverage": "vitest run --coverage",
    "lint:all": "prettier --write  \"**/*.{js,jsx,ts,tsx,md,mdx,astro,svelte}\" && eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro,svelte}\"",
    "lint:staged": "npm run lint:staged::prettier && npm run lint:staged::eslint",
    "lint:staged::prettier": "git diff --cached --name-only --diff-filter=ACM | grep \"^src/frontend/\" | sed 's/src\\/frontend\\///' | grep -E \"\\.(js|jsx|ts|tsx|md|mdx|astro|svelte)$\" | xargs -r prettier --write",
    "lint:staged::eslint": "git diff --cached --name-only --diff-filter=ACM | grep \"^src/frontend/\" | sed 's/src\\/frontend\\///' | grep -E \"\\.(js|ts|jsx|tsx|astro|svelte)$\" | xargs -r eslint --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^7.1.0",
    "@astrojs/svelte": "^9.1.0",
    "@fontsource/pacifico": "^5.3.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.0",
    "axios": "^1.13.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "^5.2.9",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.23.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
